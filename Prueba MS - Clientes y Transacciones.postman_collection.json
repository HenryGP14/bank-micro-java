                "reportes"
              ],
              "query": [
                {
                  "key": "identificacion",
                  "value": "1234567892"
                },
                {
                  "key": "fechaInicio",
                  "value": "2020-01-01"
                },
                {
                  "key": "fechaFin",
                  "value": "2030-12-31"
                }
